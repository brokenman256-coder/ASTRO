# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/astro?schema=public"

# Server
PORT=4000
CORS_ORIGIN="http://localhost:3000"

# JWT secrets - change these to long random strings in production
JWT_USER_SECRET="change-me-user-secret"
JWT_ADMIN_SECRET="change-me-admin-secret"

# Anthropic (Claude) API key - powers predictions, palm reading, and the bot's
# "formalize admin message" / autonomous prediction features.
# Without this set, the AI endpoints return a clear "AI not configured" message
# instead of failing silently.
ANTHROPIC_API_KEY=""

# OpenAI API key - powers the astrologer roster bot's AI-generated
# photorealistic headshots. Without this set, new astrologer profiles get a
# placeholder cartoon avatar instead - nothing fails, it just looks less
# real. Each image costs money (~$0.04-0.08 on DALL-E 3), and the auto-bot
# (see astrologer bot settings in the admin dashboard) can run every few
# minutes forever, so this is a real recurring cost once enabled - the
# roster size cap (default 30) bounds it, but doesn't eliminate it.
OPENAI_API_KEY=""

# --- Secret admin passage ---
# This is the "only known to admin" entrance. It is a two-step gate:
#  1. A passphrase, checked server-side, never shipped to the client bundle.
#  2. The actual admin login (username/password seeded via `npm run seed`).
# Change this to something only you know, and share it with admins out-of-band
# (never commit the real value - keep it in your deployment's env vars).
ADMIN_ACCESS_PHRASE="starlight-portal-42"

# Seed credentials for the initial Admin account (used by `npm run seed`)
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="change-this-password"

# Only used when deploying the backend as Netlify Functions (see
# backend/netlify.toml and netlify/functions/scheduler-tick.ts). Serverless
# functions can't run an in-process timer, so the astrologer auto-bot
# instead relies on an external scheduler (e.g. a free cron-job.org ping)
# hitting /scheduler-tick every few minutes. This secret stops randoms from
# hitting that endpoint directly - set it to a random string and put the
# same value in whatever pings the endpoint. Not needed on Render/other
# persistent-server deployments, which run the scheduler in-process instead.
SCHEDULER_SECRET=""
